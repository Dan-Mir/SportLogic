# SportLogic - configurazione esempio (copiare in .env e adattare)
# Il wizard di bootstrap genera questo file automaticamente.

SPORTLOGIC_APP_NAME=SportLogic
SPORTLOGIC_ENV=production
SPORTLOGIC_SECRET_KEY=change-me

# Database
SPORTLOGIC_DATABASE_URL=postgresql+psycopg://arena:arena@db:5432/arena

# Redis (worker / cache)
SPORTLOGIC_REDIS_URL=redis://redis:6379/0

# Moduli attivi (lista separata da virgola). Lasciare vuoto per usare il wizard.
SPORTLOGIC_MODULES_ENABLED=core,anagrafica,abbonamenti,certificati_medici,corsi

# LLM (chatbot) - opzionale
SPORTLOGIC_OLLAMA_URL=http://ollama:11434
SPORTLOGIC_OPENAI_API_KEY=
SPORTLOGIC_OPENAI_BASE_URL=

# Branding
SPORTLOGIC_BRAND_NAME=SportLogic
SPORTLOGIC_BRAND_PRIMARY_COLOR=#2563eb
SPORTLOGIC_PUBLIC_DOMAIN=impianto.local

# Certificati medici: chiave Fernet dedicata, base64 url-safe (32 byte)
SPORTLOGIC_DOCUMENT_ENCRYPTION_KEY=
SPORTLOGIC_DOCUMENT_STORAGE_PATH=data/medical-certificates

# SMTP locale o relay del cliente (opzionale)
SPORTLOGIC_SMTP_HOST=
SPORTLOGIC_SMTP_PORT=587
SPORTLOGIC_SMTP_USERNAME=
SPORTLOGIC_SMTP_PASSWORD=
SPORTLOGIC_SMTP_FROM_EMAIL=
SPORTLOGIC_SMTP_USE_TLS=true
