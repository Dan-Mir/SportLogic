# SportLogic - configurazione esempio (copiare in .env e adattare)
# Il wizard di bootstrap genera questo file automaticamente.

ARENA_APP_NAME=SportLogic
ARENA_ENV=production
ARENA_SECRET_KEY=change-me

# Database
ARENA_DATABASE_URL=postgresql+psycopg://arena:arena@db:5432/arena

# Redis (worker / cache)
ARENA_REDIS_URL=redis://redis:6379/0

# Moduli attivi (lista separata da virgola). Lasciare vuoto per usare il wizard.
ARENA_MODULES_ENABLED=core,anagrafica,corsi

# LLM (chatbot) - opzionale
ARENA_OLLAMA_URL=http://ollama:11434
ARENA_OPENAI_API_KEY=
ARENA_OPENAI_BASE_URL=

# Branding
ARENA_BRAND_NAME=SportLogic
ARENA_BRAND_PRIMARY_COLOR=#2563eb
ARENA_PUBLIC_DOMAIN=impianto.local
